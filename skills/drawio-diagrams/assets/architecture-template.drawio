<mxfile>
  <diagram id="architecture-example" name="構成の例">
    <mxGraphModel grid="1" gridSize="10" page="1" pageScale="1" pageWidth="1100" pageHeight="500">
      <root>
        <mxCell id="0" />
        <mxCell id="1" value="枠と説明" parent="0" />
        <mxCell id="content" value="要素と線" parent="0" />
        <mxCell id="review" value="作業メモ" parent="0" visible="0" />
        <mxCell id="title" value="境界と経路を示す構成例" style="text;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=18;fontFamily=sans-serif;html=0;" vertex="1" connectable="0" parent="1">
          <mxGeometry x="50" y="30" width="1000" height="40" as="geometry" />
        </mxCell>
        <mxCell id="example-notice" value="一般的な配置例です。実際の構成を示すものではありません。" style="text;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=18;fontFamily=sans-serif;html=0;" vertex="1" connectable="0" parent="1">
          <mxGeometry x="50" y="80" width="1000" height="40" as="geometry" />
        </mxCell>
        <mxCell id="scope" value="処理の範囲（例）" style="rounded=0;whiteSpace=wrap;align=left;verticalAlign=top;spacing=10;fillColor=none;fontSize=18;fontFamily=sans-serif;html=0;container=1;" vertex="1" connectable="0" parent="1">
          <mxGeometry x="280" y="160" width="720" height="210" as="geometry" />
        </mxCell>
        <mxCell id="legend" value="矢印：情報が渡る向き　囲み：同じ範囲として示す要素" style="text;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=18;fontFamily=sans-serif;html=0;" vertex="1" connectable="0" parent="1">
          <mxGeometry x="50" y="410" width="1000" height="40" as="geometry" />
        </mxCell>
        <mxCell id="input" value="入力" style="rounded=0;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=18;fontFamily=sans-serif;html=0;" vertex="1" parent="content">
          <mxGeometry x="70" y="240" width="140" height="70" as="geometry" />
        </mxCell>
        <mxCell id="entry" value="入口" style="rounded=0;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=18;fontFamily=sans-serif;html=0;" vertex="1" parent="content">
          <mxGeometry x="330" y="240" width="140" height="70" as="geometry" />
        </mxCell>
        <mxCell id="processing" value="処理" style="rounded=0;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=18;fontFamily=sans-serif;html=0;" vertex="1" parent="content">
          <mxGeometry x="560" y="240" width="140" height="70" as="geometry" />
        </mxCell>
        <mxCell id="storage" value="保存" style="rounded=0;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=18;fontFamily=sans-serif;html=0;" vertex="1" parent="content">
          <mxGeometry x="800" y="240" width="140" height="70" as="geometry" />
        </mxCell>
        <mxCell id="input-entry" style="endArrow=block;endFill=1;fontSize=18;fontFamily=sans-serif;html=0;" edge="1" parent="content" source="input" target="entry">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="entry-processing" style="endArrow=block;endFill=1;fontSize=18;fontFamily=sans-serif;html=0;" edge="1" parent="content" source="entry" target="processing">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="processing-storage" style="endArrow=block;endFill=1;fontSize=18;fontFamily=sans-serif;html=0;" edge="1" parent="content" source="processing" target="storage">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="review-example" value="一時的なレビュー用のメモ（例）" style="text;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=18;fontFamily=sans-serif;html=0;" vertex="1" connectable="0" parent="review">
          <mxGeometry x="60" y="130" width="500" height="30" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
