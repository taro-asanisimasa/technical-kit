<mxfile>
  <diagram id="basic-flow" name="基本の流れ">
    <mxGraphModel grid="1" gridSize="10" page="1" pageScale="1" pageWidth="840" pageHeight="400">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="heading" value="一般的な処理の例" style="text;align=center;verticalAlign=middle;whiteSpace=wrap;" vertex="1" connectable="0" parent="1">
          <mxGeometry x="60" y="40" width="720" height="40" as="geometry" />
        </mxCell>
        <mxCell id="notice" value="実際の構成を示すものではありません" style="text;align=center;verticalAlign=middle;whiteSpace=wrap;" vertex="1" connectable="0" parent="1">
          <mxGeometry x="60" y="90" width="720" height="40" as="geometry" />
        </mxCell>
        <mxCell id="input" value="入力" style="rounded=0;whiteSpace=wrap;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="80" y="190" width="120" height="70" as="geometry" />
        </mxCell>
        <mxCell id="process" value="処理" style="rounded=0;whiteSpace=wrap;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="350" y="190" width="120" height="70" as="geometry" />
        </mxCell>
        <mxCell id="output" value="出力" style="rounded=0;whiteSpace=wrap;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="620" y="190" width="120" height="70" as="geometry" />
        </mxCell>
        <mxCell id="input-to-process" style="endArrow=block;endFill=1;" edge="1" parent="1" source="input" target="process">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="process-to-output" style="endArrow=block;endFill=1;" edge="1" parent="1" source="process" target="output">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="legend" value="矢印：情報が渡る順序" style="text;align=center;verticalAlign=middle;whiteSpace=wrap;" vertex="1" connectable="0" parent="1">
          <mxGeometry x="60" y="310" width="720" height="40" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
